# Existing Glasser key. Never put provider keys in client-side code.
GLASSER_API_KEY=
GLASSER_BIN=glasser

# Azure AI / Azure OpenAI v1 (recommended). Use your actual deployment name.
MODEL_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
DATA_PROVIDER=glasser
GLASSER_API_BASE_URL=https://api.glasser.ai
# Optional direct evidence vendors (DATA_PROVIDER=direct):
# SERPER_API_KEY=
# EXA_API_KEY=
# TIKHUB_API_KEY=
# SCRAPECREATORS_API_KEY=
# Optional: set only for legacy deployment-based Azure APIs.
# AZURE_OPENAI_API_VERSION=2024-10-21
# Rates MUST match your deployment; these are configured estimates, not invoice prices.
MODEL_INPUT_USD_PER_MILLION=0.20
MODEL_CACHED_INPUT_USD_PER_MILLION=0.02
MODEL_OUTPUT_USD_PER_MILLION=1.20
SERVICE_FEE_USD=0.005
CACHE_TTL_SECONDS=900
CACHE_DIR=.claimcheck/cache
# Other OpenAI-compatible providers: set MODEL_PROVIDER=openai and these:
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4.1-mini

# Shared secret injected by the pay gateway into origin requests.
# Generate once with: openssl rand -hex 32
ORIGIN_API_KEY=
HOST=127.0.0.1
PORT=3000
DEMO_MODE=false

# Production pay gateway (sandbox creates an ephemeral operator).
UPSTREAM_BASE_URL=http://127.0.0.1:3000/
PAY_RPC_URL=
PAY_PAYMENT_RECIPIENT=
PAY_MPP_CHALLENGE_SECRET=
PAY_OPERATOR_KEYPAIR=
