{
  "name": "facet",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node --import tsx scripts/patch-pay-kit.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "dev:worker": "wrangler dev",
    "test": "node --import tsx --test test/*.test.ts",
    "release:audit": "node --import tsx scripts/release-audit.ts",
    "sandbox": "node --env-file-if-exists=.env --import tsx scripts/sandbox.ts",
    "pay": "pay"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@solana/pay": "1.0.26",
    "@solana/pay-kit": "0.12.0",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=22"
  }
}
